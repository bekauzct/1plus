# docker compose uchun namuna: cp .env.example .env
#
# Serverda HTTPS'siz (http://IP:8000) SINAB KO'RISH uchun:
#   DJANGO_ALLOWED_HOSTS=<server-IP>,localhost,127.0.0.1
#   DJANGO_CSRF_TRUSTED_ORIGINS=http://<server-IP>:8000
#   DJANGO_SECURE_COOKIES=0     # aks holda http'da CSRF cookie o'rnatilmaydi -> preview/PDF 403
#   SITE_URL=http://<server-IP>:8000
#
# Production (HTTPS, domen bilan):
DJANGO_SECRET_KEY=uzun-tasodifiy-kalit
DJANGO_ALLOWED_HOSTS=obyektivka.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://obyektivka.example.uz
DJANGO_SECURE_COOKIES=1
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=31536000
SITE_URL=https://obyektivka.example.uz
TRUST_PROXY_HEADERS=1
WEB_CONCURRENCY=3

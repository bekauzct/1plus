# docker compose uchun namuna: cp .env.example .env
DJANGO_SECRET_KEY=uzun-tasodifiy-kalit
DJANGO_ALLOWED_HOSTS=obyektivka.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://obyektivka.example.uz
DJANGO_SECURE_COOKIES=1
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=31536000
SITE_URL=https://obyektivka.example.uz
TRUST_PROXY_HEADERS=1
WEB_CONCURRENCY=3
